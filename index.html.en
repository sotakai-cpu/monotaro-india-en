  <!-- Dedicated Support Team Section -->
  <section class="py-10 bg-amber-50/50 border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <span class="text-xs font-bold text-amber-800 bg-amber-200/70 px-3 py-1 rounded-full uppercase tracking-wider inline-block mb-2">Local Entity Advantage in India</span>
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-3">
        Dedicated Japanese Experts & Local Indian Sourcing Team
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 max-w-3xl mx-auto mb-6">
        Our local entity in India combines deep knowledge of Japanese industrial products with seamless local operations. You get the best of both worlds: Japanese precision & local responsiveness.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto text-left">
        <!-- Japanese Support Card -->
        <div class="bg-white p-5 rounded-xl border border-slate-300 shadow-sm flex items-start space-x-4">
          <div class="w-12 h-12 bg-red-100 text-red-600 rounded-lg flex items-center justify-center text-xl shrink-0">
            <i class="fa-solid fa-earth-asia"></i>
          </div>
          <div>
            <h3 class="font-bold text-base text-slate-900 mb-1">Japanese Product Specialists</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Our Japanese staff stationed in India are well-versed in Japanese manufacturing standards (JIS/MRO) and can consult directly on part numbers, specifications, and equivalents in Japanese or English.
            </p>
          </div>
        </div>

        <!-- Indian Local Support Card -->
        <div class="bg-white p-5 rounded-xl border border-slate-300 shadow-sm flex items-start space-x-4">
          <div class="w-12 h-12 bg-amber-100 text-amber-700 rounded-lg flex items-center justify-center text-xl shrink-0">
            <i class="fa-solid fa-users-gear"></i>
          </div>
          <div>
            <h3 class="font-bold text-base text-slate-900 mb-1">Local Operations Team</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Our experienced procurement & logistics staff in India ensure smooth local GST invoicing, fast customs clearance via our Haryana warehouse, and prompt doorstep delivery across India.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MonotaRO Catalog Showcase -->
  <section class="py-10 bg-slate-50 border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <span class="text-xs font-bold text-amber-700 bg-amber-100 px-3 py-1 rounded-full uppercase tracking-wider inline-block mb-2">High Cost-Performance Solutions</span>
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-3">
        MonotaRO & High-Quality Japanese Brands
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 max-w-3xl mx-auto mb-6">
        Through MonotaRO's extensive supply chain of over <strong>28 Million SKUs</strong>, we offer top-tier Japanese industrial brands along with MonotaRO’s exclusive products—delivering Japanese standard reliability at highly cost-effective prices.
      </p>

      <div class="bg-white p-6 rounded-2xl border border-slate-300 shadow-sm max-w-3xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="w-full md:w-1/2 flex justify-center border-b md:border-b-0 md:border-r border-slate-200 pb-4 md:pb-0 md:pr-6">
          <img src="プライベートブランドロゴ_余白ありRGB.jpg" alt="MonotaRO Product Lineup" class="max-h-24 w-auto object-contain">
        </div>
        <div class="w-full md:w-1/2 text-left space-y-2">
          <h3 class="font-bold text-sm text-slate-900 flex items-center">
            <i class="fa-solid fa-circle-check text-emerald-600 mr-2"></i> Factory-Direct Cost Savings
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            High-utility consumables, tools, PPE, and maintenance equipment designed specifically for industrial plant usage with zero quality compromise.
          </p>
          <div class="pt-1">
            <a href="#inquiry-form" class="inline-flex items-center text-xs font-bold text-amber-700 hover:text-amber-800">
              Request Catalog & Quote <i class="fa-solid fa-arrow-right ml-1"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Value Propositions Section -->
  <section class="py-12 bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-xl sm:text-2xl font-bold text-center text-slate-900 mb-8">
        Why Source Japanese Industrial Supplies Through Us?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Feature 1 -->
        <div class="bg-slate-50 p-6 rounded-xl border border-slate-200 shadow-sm relative">
          <div class="w-12 h-12 bg-amber-100 text-amber-700 rounded-lg flex items-center justify-center text-xl font-bold mb-4">
            <i class="fa-solid fa-tags"></i>
          </div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Factory-Direct Pricing Synergy</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            MonotaRO is Japan’s leading industrial e-commerce giant with access to over 28 Million products. By bypassing multi-tier importers, we offer highly competitive factory-direct rates for genuine Japanese tools, spares, and machinery.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="bg-slate-50 p-6 rounded-xl border border-slate-200 shadow-sm relative">
          <div class="w-12 h-12 bg-amber-100 text-amber-700 rounded-lg flex items-center justify-center text-xl font-bold mb-4">
            <i class="fa-solid fa-truck-fast"></i>
          </div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Express Air Freight (20 Days)</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Eliminate long import lead times and plant shutdowns. Products are dispatched via express air freight directly to our Haryana warehouse and delivered to your doorstep <strong>within 20 days</strong>. VMI stocking is also available.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="bg-slate-50 p-6 rounded-xl border border-slate-200 shadow-sm relative">
          <div class="w-12 h-12 bg-amber-100 text-amber-700 rounded-lg flex items-center justify-center text-xl font-bold mb-4">
            <i class="fa-solid fa-file-invoice-dollar"></i>
          </div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">All-Inclusive INR & GST Billing</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            No forex complexities, customs clearance hassles, or unexpected charges. Pay transparently in <strong>local Indian Rupees (INR)</strong> with full GST Input Tax Credit (ITC) compliance and door delivery included.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Simple Steps Section -->
  <section class="py-10 bg-slate-100 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-lg sm:text-xl font-bold text-center text-slate-900 mb-6">
        <i class="fa-solid fa-list-check text-amber-600 mr-2"></i>How It Works (Simple 3 Steps)
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-center">
        <div class="bg-white p-5 rounded-xl border border-slate-300 shadow-sm">
          <div class="w-9 h-9 bg-ib-yellow text-slate-900 font-black rounded-full flex items-center justify-center text-base mx-auto mb-3 shadow-sm border border-amber-400">1</div>
