      <div class="flex items-center space-x-2 sm:space-x-3">
        <a href="https://www.industrybuying.com/?utm_source=japan" target="_blank" rel="noopener noreferrer" class="hidden md:inline-flex items-center text-xs font-bold text-slate-900 bg-ib-yellow hover:bg-ib-yellow-dark px-3.5 py-2.5 rounded-lg transition shadow-sm">
